# PostgreSQL connection (Prisma)
DATABASE_URL=
# Optional direct (non-pooled) URL used for migrations/seeding
DIRECT_DATABASE_URL=

# Auth / sessions
SESSION_SECRET=change-me-in-production

# Google sign-in (server verifies the credential's audience against this)
GOOGLE_CLIENT_ID=

# Transactional email (Gmail app password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: Vercel Blob for admin uploads (falls back to inline base64 if unset)
BLOB_READ_WRITE_TOKEN=

# Server port and the client origin allowed via CORS
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
